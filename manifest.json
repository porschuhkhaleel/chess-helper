{
  "manifest_version": 3,
  "name": "Chess.com AI Overlay",
  "version": "1.0",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["*://*.chess.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.chess.com/*", "*://chess.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["worker.js", "stockfish.js", "stockfish.wasm", "engine.html", "engine.js"],
      "matches": ["*://*.chess.com/*", "*://chess.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}